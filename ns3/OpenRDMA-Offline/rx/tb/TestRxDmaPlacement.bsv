import CommonTypes::*;
import RxTypes::*;
import RxDmaPlacement::*;

interface TestRxDmaPlacement;
    method Action configureEpoch(RxEpoch value);
    method RxGlobalSeq retireHead;
    method Bool faulted;
    interface PipeIn#(RxAdmittedPacket) lane0AdmittedIn;
    interface PipeIn#(RxAdmittedPacket) lane1AdmittedIn;
    interface PipeIn#(RxAdmittedPacket) lane2AdmittedIn;
    interface PipeIn#(RxAdmittedPacket) lane3AdmittedIn;
    interface PipeOut#(RxDmaWriteRequest) lane0RequestOut;
    interface PipeOut#(RxDmaWriteRequest) lane1RequestOut;
    interface PipeOut#(RxDmaWriteRequest) lane2RequestOut;
    interface PipeOut#(RxDmaWriteRequest) lane3RequestOut;
    interface PipeOut#(RxDmaPayloadBeat) lane0PayloadOut;
    interface PipeOut#(RxDmaPayloadBeat) lane1PayloadOut;
    interface PipeOut#(RxDmaPayloadBeat) lane2PayloadOut;
    interface PipeOut#(RxDmaPayloadBeat) lane3PayloadOut;
    interface PipeIn#(RxDmaCompletion) lane0CompletionIn;
    interface PipeIn#(RxDmaCompletion) lane1CompletionIn;
    interface PipeIn#(RxDmaCompletion) lane2CompletionIn;
    interface PipeIn#(RxDmaCompletion) lane3CompletionIn;
    interface PipeOut#(RxPayloadReadRequest) lane0ReadRequestOut;
    interface PipeOut#(RxPayloadReadRequest) lane1ReadRequestOut;
    interface PipeOut#(RxPayloadReadRequest) lane2ReadRequestOut;
    interface PipeOut#(RxPayloadReadRequest) lane3ReadRequestOut;
    interface PipeIn#(RxPayloadReadResponse) lane0ReadResponseIn;
    interface PipeIn#(RxPayloadReadResponse) lane1ReadResponseIn;
    interface PipeIn#(RxPayloadReadResponse) lane2ReadResponseIn;
    interface PipeIn#(RxPayloadReadResponse) lane3ReadResponseIn;
    interface PipeOut#(RxBufferRelease) lane0ReleaseOut;
    interface PipeOut#(RxBufferRelease) lane1ReleaseOut;
    interface PipeOut#(RxBufferRelease) lane2ReleaseOut;
    interface PipeOut#(RxBufferRelease) lane3ReleaseOut;
    interface PipeOut#(RxError) lane0ErrorOut;
    interface PipeOut#(RxError) lane1ErrorOut;
    interface PipeOut#(RxError) lane2ErrorOut;
    interface PipeOut#(RxError) lane3ErrorOut;
    interface PipeOut#(RxDmaRetire) retireOut;
endinterface

(* synthesize *)
module mkTestRxDmaPlacement(TestRxDmaPlacement);
    let dut <- mkRxDmaPlacement;
    method Action configureEpoch(RxEpoch value); dut.configureEpoch(value); endmethod
    method RxGlobalSeq retireHead = dut.retireHead;
    method Bool faulted = dut.faulted;
    interface lane0AdmittedIn = dut.admitted[0];
    interface lane1AdmittedIn = dut.admitted[1];
    interface lane2AdmittedIn = dut.admitted[2];
    interface lane3AdmittedIn = dut.admitted[3];
    interface lane0RequestOut = dut.requests[0];
    interface lane1RequestOut = dut.requests[1];
    interface lane2RequestOut = dut.requests[2];
    interface lane3RequestOut = dut.requests[3];
    interface lane0PayloadOut = dut.payloads[0];
    interface lane1PayloadOut = dut.payloads[1];
    interface lane2PayloadOut = dut.payloads[2];
    interface lane3PayloadOut = dut.payloads[3];
    interface lane0CompletionIn = dut.completions[0];
    interface lane1CompletionIn = dut.completions[1];
    interface lane2CompletionIn = dut.completions[2];
    interface lane3CompletionIn = dut.completions[3];
    interface lane0ReadRequestOut = dut.readRequests[0];
    interface lane1ReadRequestOut = dut.readRequests[1];
    interface lane2ReadRequestOut = dut.readRequests[2];
    interface lane3ReadRequestOut = dut.readRequests[3];
    interface lane0ReadResponseIn = dut.readResponses[0];
    interface lane1ReadResponseIn = dut.readResponses[1];
    interface lane2ReadResponseIn = dut.readResponses[2];
    interface lane3ReadResponseIn = dut.readResponses[3];
    interface lane0ReleaseOut = dut.releases[0];
    interface lane1ReleaseOut = dut.releases[1];
    interface lane2ReleaseOut = dut.releases[2];
    interface lane3ReleaseOut = dut.releases[3];
    interface lane0ErrorOut = dut.errors[0];
    interface lane1ErrorOut = dut.errors[1];
    interface lane2ErrorOut = dut.errors[2];
    interface lane3ErrorOut = dut.errors[3];
    interface retireOut = dut.retireOut;
endmodule
